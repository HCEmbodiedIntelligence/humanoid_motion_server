include_guard(GLOBAL)

find_package(Eigen3 REQUIRED)

get_filename_component(
  _humanoid_motion_server_sdk_prefix
  "${CMAKE_CURRENT_LIST_DIR}/../../.."
  ABSOLUTE
)
# Resolve the exact ABI-compatible dependency set from the normal system CMake
# search path. Source-built dependencies use the standard /usr/local layout.
find_package(ruckig 0.17.3 EXACT REQUIRED CONFIG)
find_package(toppra 0.6.8 EXACT REQUIRED CONFIG)
find_package(NLopt 2.10.1 EXACT REQUIRED CONFIG)
find_package(trac_ik_lib 0.1.0 EXACT REQUIRED CONFIG)
find_package(eiquadprog 1.3.2 EXACT REQUIRED CONFIG)
find_package(hpp-fcl 2.4.4 EXACT REQUIRED CONFIG)
find_package(pinocchio 3.9.0 EXACT REQUIRED CONFIG)

set(_humanoid_motion_server_sdk_libdir
  "${_humanoid_motion_server_sdk_prefix}/@CMAKE_INSTALL_LIBDIR@")
set(_humanoid_motion_server_sdk_include_dir
  "${_humanoid_motion_server_sdk_prefix}/@CMAKE_INSTALL_INCLUDEDIR@")
set(_humanoid_motion_server_sdk_build_rpath
  "${_humanoid_motion_server_sdk_libdir}")
set(_humanoid_motion_server_sdk_install_rpath
  "\$ORIGIN")

function(_humanoid_motion_server_sdk_import target_name library_name)
  set(_target "humanoid_motion_server_sdk::${target_name}")
  if(TARGET "${_target}")
    return()
  endif()

  set(_location "${_humanoid_motion_server_sdk_libdir}/${library_name}")
  if(NOT EXISTS "${_location}")
    message(FATAL_ERROR
      "${_target} references a missing installed SDK library: ${_location}")
  endif()

  add_library("${_target}" SHARED IMPORTED)
  set_target_properties("${_target}" PROPERTIES
    IMPORTED_LOCATION "${_location}"
    IMPORTED_SONAME "${library_name}"
    INTERFACE_INCLUDE_DIRECTORIES
      "${_humanoid_motion_server_sdk_include_dir};${_humanoid_motion_server_sdk_include_dir}/motion_control"
    BUILD_RPATH "${_humanoid_motion_server_sdk_build_rpath}"
    INSTALL_RPATH "${_humanoid_motion_server_sdk_install_rpath}"
    INTERFACE_LINK_OPTIONS "LINKER:--disable-new-dtags"
  )
endfunction()

_humanoid_motion_server_sdk_import(placo liblibplaco.so)
_humanoid_motion_server_sdk_import(motion_control libmotion_control.so)
_humanoid_motion_server_sdk_import(robo_manip librobo_manip.so)

set_property(TARGET humanoid_motion_server_sdk::placo PROPERTY
  INTERFACE_LINK_LIBRARIES
  "eiquadprog::eiquadprog;pinocchio::pinocchio_default;pinocchio::pinocchio_parsers;hpp-fcl::hpp-fcl;Eigen3::Eigen")
set_property(TARGET humanoid_motion_server_sdk::motion_control PROPERTY
  INTERFACE_LINK_LIBRARIES
  "humanoid_motion_server_sdk::placo;ruckig::ruckig;toppra::toppra;trac_ik_lib::trac_ik_lib;pinocchio::pinocchio_default;pinocchio::pinocchio_parsers;Eigen3::Eigen")
set_property(TARGET humanoid_motion_server_sdk::robo_manip PROPERTY
  INTERFACE_LINK_LIBRARIES
  "humanoid_motion_server_sdk::motion_control;Eigen3::Eigen")

set_property(TARGET humanoid_motion_server_sdk::placo APPEND PROPERTY
  INTERFACE_LINK_OPTIONS
  "LINKER:SHELL:--push-state --no-as-needed $<TARGET_FILE:eiquadprog::eiquadprog> $<TARGET_FILE:pinocchio::pinocchio_default> $<TARGET_FILE:pinocchio::pinocchio_parsers> $<TARGET_FILE:hpp-fcl::hpp-fcl> --pop-state")
set_property(TARGET humanoid_motion_server_sdk::motion_control APPEND PROPERTY
  INTERFACE_LINK_OPTIONS
  "LINKER:SHELL:--push-state --no-as-needed $<TARGET_FILE:humanoid_motion_server_sdk::placo> $<TARGET_FILE:ruckig::ruckig> $<TARGET_FILE:toppra::toppra> $<TARGET_FILE:trac_ik_lib::trac_ik_lib> $<TARGET_FILE:pinocchio::pinocchio_default> $<TARGET_FILE:pinocchio::pinocchio_parsers> --pop-state")
set_property(TARGET humanoid_motion_server_sdk::robo_manip APPEND PROPERTY
  INTERFACE_LINK_OPTIONS
  "LINKER:SHELL:--push-state --no-as-needed $<TARGET_FILE:humanoid_motion_server_sdk::motion_control> --pop-state")

unset(_humanoid_motion_server_sdk_build_rpath)
unset(_humanoid_motion_server_sdk_include_dir)
unset(_humanoid_motion_server_sdk_install_rpath)
unset(_humanoid_motion_server_sdk_libdir)
unset(_humanoid_motion_server_sdk_prefix)
