<?xml version="1.0"?>
<!-- A purpose-built integration-test humanoid. It contains no OpenArm/Demo assets. -->
<robot name="minimal_test_humanoid">
  <link name="base_link"/>
  <link name="torso_link"/>
  <joint name="torso_yaw" type="revolute">
    <parent link="base_link"/>
    <child link="torso_link"/>
    <origin xyz="0 0 0.55" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.2" upper="1.2" effort="30" velocity="2"/>
  </joint>

  <link name="head_link"/>
  <joint name="neck_yaw" type="revolute">
    <parent link="torso_link"/>
    <child link="head_link"/>
    <origin xyz="0 0 0.32" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5" upper="1.5" effort="8" velocity="2"/>
  </joint>

  <link name="left_upper_arm"/>
  <joint name="left_shoulder_pitch" type="revolute">
    <parent link="torso_link"/>
    <child link="left_upper_arm"/>
    <origin xyz="0 0.22 0.24" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.4" upper="2.4" effort="20" velocity="3"/>
  </joint>
  <link name="left_wrist_link"/>
  <joint name="left_elbow" type="revolute">
    <parent link="left_upper_arm"/>
    <child link="left_wrist_link"/>
    <origin xyz="0.28 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="0.1" effort="15" velocity="3"/>
  </joint>

  <link name="right_upper_arm"/>
  <joint name="right_shoulder_pitch" type="revolute">
    <parent link="torso_link"/>
    <child link="right_upper_arm"/>
    <origin xyz="0 -0.22 0.24" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.4" upper="2.4" effort="20" velocity="3"/>
  </joint>
  <link name="right_wrist_link"/>
  <joint name="right_elbow" type="revolute">
    <parent link="right_upper_arm"/>
    <child link="right_wrist_link"/>
    <origin xyz="0.28 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="0.1" effort="15" velocity="3"/>
  </joint>

  <link name="left_leg_link"/>
  <joint name="left_leg_mount" type="fixed">
    <parent link="base_link"/>
    <child link="left_leg_link"/>
    <origin xyz="0 0.10 -0.45" rpy="0 0 0"/>
  </joint>
  <link name="right_leg_link"/>
  <joint name="right_leg_mount" type="fixed">
    <parent link="base_link"/>
    <child link="right_leg_link"/>
    <origin xyz="0 -0.10 -0.45" rpy="0 0 0"/>
  </joint>
</robot>
